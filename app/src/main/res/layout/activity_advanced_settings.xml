<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_collapse"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:rotation="90"
                android:contentDescription="Back"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="> ADVANCED SETTINGS"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:fontFamily="@font/roboto_mono" />
        </LinearLayout>

        <!-- Polling Interval Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-- POLLING INTERVAL --"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How often the service logs battery data. Lower values give more granular history but use slightly more resources."
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:layout_marginBottom="12dp" />

        <!-- Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_detail_card"
            android:padding="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interval"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_interval_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5m 0s"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekbar_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/accent_cyan"
                android:thumbTint="@color/accent_cyan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1s"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30m"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Precise ms input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precise (ms):"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_interval_ms"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_search_field"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:inputType="number"
                    android:hint="300000"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:maxLength="8"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_apply_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_active"
                    app:backgroundTint="@null"
                    android:text="APPLY"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:fontFamily="@font/roboto_mono"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Data Sources Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="-- DATA SOURCES --"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detected sources for battery data on this device. Green = available and returning data."
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <!-- Current Sources Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CURRENT"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_mono" />

        <LinearLayout
            android:id="@+id/ll_current_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <!-- Charge Sources Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHARGE COUNTER"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_mono" />

        <LinearLayout
            android:id="@+id/ll_charge_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <!-- Energy Sources Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENERGY"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_mono" />

        <LinearLayout
            android:id="@+id/ll_energy_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <!-- Device Info Sources -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM INFO"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_mono" />

        <LinearLayout
            android:id="@+id/ll_info_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <!-- Refresh Button -->
        <Button
            android:id="@+id/btn_refresh_sources"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_secondary"
            app:backgroundTint="@null"
            android:text="> REFRESH DATA SOURCES"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_mono"
            android:stateListAnimator="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
